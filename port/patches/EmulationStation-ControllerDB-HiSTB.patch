diff --git a/es-core/src/InputManager.cpp b/es-core/src/InputManager.cpp
--- a/es-core/src/InputManager.cpp
+++ b/es-core/src/InputManager.cpp
@@ -11,6 +11,7 @@
 #include <iostream>
 #include <assert.h>
 #include "Settings.h"
+#include <cstdlib>
 #include <algorithm>
 
 #define KEYBOARD_GUID_STRING "-1"
@@ -58,6 +59,16 @@ void InputManager::init()
 	SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, 
 		Settings::getInstance()->getBool("BackgroundJoystickInput") ? "1" : "0");
 	SDL_InitSubSystem(SDL_INIT_JOYSTICK);
+	const char* controllerDb = std::getenv("HISTB_GAMECONTROLLERDB");
+	if(controllerDb != NULL && controllerDb[0] != '\0')
+	{
+		int mappings = SDL_GameControllerAddMappingsFromFile(controllerDb);
+		if(mappings >= 0)
+			LOG(LogInfo) << "Loaded " << mappings << " SDL controller mappings from " << controllerDb;
+		else
+			LOG(LogWarning) << "Could not load SDL controller mappings from " << controllerDb
+				<< ": " << SDL_GetError();
+	}
 	SDL_JoystickEventState(SDL_ENABLE);
 
