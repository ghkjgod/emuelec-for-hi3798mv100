#!/bin/sh

set -u

STORAGE_ROOT=${HISTB_STORAGE_ROOT:-/storage}
CONFIG_DIR=${STORAGE_ROOT}/.config/emuelec/configs
CONFIG_FILE=${CONFIG_DIR}/emuelec.conf

valid_key()
{
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_value()
{
    case "$1" in
        *[!A-Za-z0-9._:+/@,-]*) return 1 ;;
        *) return 0 ;;
    esac
}

require_storage()
{
    case "${STORAGE_ROOT}" in
        /|'') echo "refusing unsafe storage root" >&2; return 1 ;;
        /*) ;;
        *) echo "storage root must be absolute" >&2; return 1 ;;
    esac
    HISTB_STORAGE_ROOT="${STORAGE_ROOT}" \
        /usr/bin/histb-storage-guard --require-marker
}

config_get()
{
    key=$1
    valid_key "${key}" || return 2
    [ -f "${CONFIG_FILE}" ] || return 0
    awk -F= -v wanted="${key}" '
        $0 !~ /^[#;]/ && $1 == wanted {
            sub(/^[^=]*=/, "")
            value=$0
        }
        END { if (value != "") print value }
    ' "${CONFIG_FILE}"
}

config_set()
{
    key=$1
    value=$2
    valid_key "${key}" && valid_value "${value}" || return 2
    require_storage
    mkdir -p "${CONFIG_DIR}"
    temp_file=${CONFIG_FILE}.new.$$
    trap 'rm -f -- "${temp_file}"' EXIT HUP INT TERM
    if [ -f "${CONFIG_FILE}" ]; then
        awk -F= -v wanted="${key}" -v replacement="${value}" '
            BEGIN { found=0 }
            $0 !~ /^[#;]/ && $1 == wanted {
                if (!found) print wanted "=" replacement
                found=1
                next
            }
            { print }
            END { if (!found) print wanted "=" replacement }
        ' "${CONFIG_FILE}" >"${temp_file}"
    else
        printf '%s=%s\n' "${key}" "${value}" >"${temp_file}"
    fi
    chmod 0644 "${temp_file}"
    mv -f "${temp_file}" "${CONFIG_FILE}"
    trap - EXIT HUP INT TERM
}

case "${1:-}" in
    setemu)
        action=${2:-}
        key=${3:-}
        case "${action}" in
            get) config_get "${key}" ;;
            set)
                shift 3
                value=${1:-}
                [ "$#" -eq 1 ] || {
                    echo 'setemu set requires exactly one value' >&2
                    exit 2
                }
                config_set "${key}" "${value}"
                ;;
            *) echo "unsupported setemu action: ${action}" >&2; exit 2 ;;
        esac
        ;;
    getip)
        if command -v ip >/dev/null 2>&1; then
            ip -4 -o addr show scope global 2>/dev/null |
                awk '{ sub(/\/.*/, "", $4); print $4; exit }'
        elif command -v hostname >/dev/null 2>&1; then
            hostname -I 2>/dev/null | awk '{ print $1 }'
        fi
        ;;
    resolutions)
        if [ -r /sys/class/display/mode ]; then
            mode=$(sed -n '1p' /sys/class/display/mode 2>/dev/null || true)
            [ -z "${mode}" ] || printf '%s,' "${mode}"
        fi
        ;;
    current_timezone)
        date '+%Z' 2>/dev/null || true
        ;;
    timezones)
        zone=$(date '+%Z' 2>/dev/null || true)
        [ -z "${zone}" ] || printf '%s,' "${zone}"
        ;;
    getshaders)
        :
        ;;
    '')
        echo 'usage: emuelec-utils COMMAND [ARGUMENTS...]' >&2
        exit 2
        ;;
    *)
        echo "unsupported emuelec-utils command: $1" >&2
        exit 2
        ;;
esac
