/tf-card/EmuELEC/bios/
/tf-card/EmuELEC/roms/
!/tf-card/EmuELEC/cores/*_libretro.so
shadow
shadow-
authorized_keys
known_hosts
*host_key*
*.log
*.pcap
*.wav
*.mkv

